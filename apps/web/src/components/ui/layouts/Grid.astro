---
/**
 * Grid Component
 *
 * A layout component for two-dimensional layouts using CSS Grid.
 * Based on every-layout.dev's Grid primitive for intrinsic web design.
 *
 * Features:
 * - Configurable grid columns and rows
 * - Responsive grid configurations
 * - Flexible gap spacing
 * - Auto-fit and auto-fill support
 * - Responsive and bilingual support
 */

// Define types for the props
type GapOption = 'none' | 'xs' | 'sm' | 'md' | 'lg' | 'xl' | '2xl';
type BehaviorOption = 'auto-fit' | 'auto-fill' | 'fixed';
type AlignOption = 'start' | 'center' | 'end' | 'stretch';
type JustifyOption = 'start' | 'center' | 'end' | 'stretch';

export interface Props {
  /** Minimum width for auto-fit/auto-fill columns */
  minItemWidth?: string;
  /** Fixed number of columns (overrides minItemWidth) */
  columns?: number;
  /** Fixed number of rows */
  rows?: number;
  /** Gap between grid items */
  gap?: GapOption;
  /** Grid behavior: auto-fit, auto-fill, or fixed */
  behavior?: BehaviorOption;
  /** Alignment of grid items */
  align?: AlignOption;
  /** Justification of grid items */
  justify?: JustifyOption;
  /** Additional CSS classes */
  class?: string;
  /** HTML element to render as */
  as?: keyof HTMLElementTagNameMap;
}

const {
  minItemWidth = '250px',
  columns,
  rows,
  gap = 'md',
  behavior = 'auto-fit',
  align = 'stretch',
  justify = 'stretch',
  class: className = '',
  as: Element = 'div',
} = Astro.props as Props;

// Map gap prop to CSS custom property values
const gapMap: Record<GapOption, string> = {
  'none': '0',
  'xs': 'var(--space-1)',
  'sm': 'var(--space-2)',
  'md': 'var(--space-4)',
  'lg': 'var(--space-6)',
  'xl': 'var(--space-10)',
  '2xl': 'var(--space-12)',
};

// Map align prop to CSS values
const alignMap: Record<AlignOption, string> = {
  'start': 'start',
  'center': 'center',
  'end': 'end',
  'stretch': 'stretch',
};

// Map justify prop to CSS values
const justifyMap: Record<JustifyOption, string> = {
  'start': 'start',
  'center': 'center',
  'end': 'end',
  'stretch': 'stretch',
};

const gapValue = gapMap[gap as GapOption];
const alignValue = alignMap[align as AlignOption];
const justifyValue = justifyMap[justify as JustifyOption];

// Build grid template columns based on behavior and props
let gridTemplateColumns: string;

if (columns) {
  // Fixed number of columns
  gridTemplateColumns = `repeat(${columns}, 1fr)`;
} else if (behavior === 'auto-fit') {
  // Auto-fit: empty columns collapse
  gridTemplateColumns = `repeat(auto-fit, minmax(${minItemWidth}, 1fr))`;
} else if (behavior === 'auto-fill') {
  // Auto-fill: empty columns remain
  gridTemplateColumns = `repeat(auto-fill, minmax(${minItemWidth}, 1fr))`;
} else {
  // Default to auto-fit
  gridTemplateColumns = `repeat(auto-fit, minmax(${minItemWidth}, 1fr))`;
}

// Build grid template rows if specified
const gridTemplateRows = rows ? `repeat(${rows}, 1fr)` : 'auto';

// Build CSS custom properties for the component
const customProperties = {
  '--grid-gap': gapValue,
  '--grid-align': alignValue,
  '--grid-justify': justifyValue,
  '--grid-template-columns': gridTemplateColumns,
  '--grid-template-rows': gridTemplateRows,
};

// Build CSS classes
const classes = ['grid', `grid--${behavior}`, className].filter(Boolean);
---

<Element class:list={classes} style={customProperties}>
  <slot />
</Element>

<style>
  .grid {
    display: grid;
    grid-template-columns: var(--grid-template-columns);
    grid-template-rows: var(--grid-template-rows, auto);
    gap: var(--grid-gap, var(--space-4));
    align-items: var(--grid-align, stretch);
    justify-items: var(--grid-justify, stretch);
  }

  /* Remove default margins from direct children */
  .grid > * {
    margin: 0;
  }

  /* Auto-fit behavior: columns collapse when empty */
  .grid--auto-fit {
    /* Already handled in grid-template-columns */
  }

  /* Auto-fill behavior: columns remain even when empty */
  .grid--auto-fill {
    /* Already handled in grid-template-columns */
  }

  /* Fixed behavior: explicit column count */
  .grid--fixed {
    /* Already handled in grid-template-columns */
  }

  /* Responsive adjustments for better mobile experience */
  @media (max-width: 640px) {
    .grid {
      /* Reduce gap on mobile for better space utilization */
      --grid-gap-mobile: calc(var(--grid-gap, var(--space-4)) * 0.75);
      gap: var(--grid-gap-mobile, var(--grid-gap, var(--space-4)));

      /* Force single column on very small screens for auto-fit/auto-fill */
      --grid-min-width-mobile: 100%;
    }

    .grid--auto-fit,
    .grid--auto-fill {
      grid-template-columns: 1fr;
    }
  }

  /* Tablet adjustments */
  @media (min-width: 641px) and (max-width: 1024px) {
    .grid--auto-fit,
    .grid--auto-fill {
      /* Adjust minimum width for tablet */
      grid-template-columns: repeat(
        var(--grid-behavior, auto-fit),
        minmax(200px, 1fr)
      );
    }
  }

  /* Support for reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .grid * {
      transition: none;
    }
  }

  /* High contrast mode support */
  @media (prefers-contrast: high) {
    .grid > * {
      border: 1px solid CanvasText;
    }
  }

  /* Focus management for keyboard navigation */
  .grid:focus-within {
    outline: 2px solid var(--color-blue-light);
    outline-offset: 2px;
  }

  /* Ensure proper spacing for interactive elements */
  .grid > button,
  .grid > a,
  .grid > [role='button'] {
    min-height: 44px; /* Minimum touch target size */
  }

  /* Special grid variants */
  .grid.card-grid > * {
    padding: var(--space-4);
    border: var(--border-width-normal) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .grid.image-grid > * {
    aspect-ratio: 1;
    object-fit: cover;
  }

  .grid.masonry-grid {
    grid-template-rows: masonry;
  }

  /* Support for CSS Subgrid when available */
  @supports (grid-template-rows: subgrid) {
    .grid.subgrid > * {
      display: grid;
      grid-template-rows: subgrid;
    }
  }

  /* Dense packing for varied content sizes */
  .grid.dense {
    grid-auto-flow: dense;
  }

  /* Equal height rows */
  .grid.equal-rows {
    grid-auto-rows: 1fr;
  }

  /* Intrinsic sizing - let content determine size */
  .grid.intrinsic {
    grid-template-columns: repeat(auto-fit, minmax(min-content, max-content));
  }
</style>
