---
/**
 * Design System Demo Page
 * 
 * This page demonstrates the components from the design system
 * implementation. It shows how to use Stack, Box, Cluster, Grid, Sidebar,
 * Heading, Text, Link, Button, Input, Select, Checkbox, and Radio components with various configurations.
 */

import '../styles/global.css';
import { Stack, Box, Cluster, Grid, Sidebar, Heading, Text, Link, Button, Input, Select, Checkbox, Radio } from '../components/ui';
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width" />
  <meta name="generator" content={Astro.generator} />
  <title>Design System Demo - Layout Components</title>
  <style>
    /* Base styles for demo page */
    body {
      background-color: var(--color-background);
      color: var(--color-text-primary);
    }
    
    /* Debug styles for buttons */
    .debug-info {
      margin-top: 1rem;
      padding: 1rem;
      background-color: #f0f0f0;
      border: 1px solid #ccc;
      border-radius: 4px;
      font-family: monospace;
      font-size: 0.875rem;
    }
    
    /* Neo-brutalist shadow for demo */
    .neo-shadow {
      position: relative;
      top: -6px;
      left: -6px;
      box-shadow: 6px 6px 0 0 rgba(0, 0, 0, 0.9);
    }
    
    /* Form element styles */
    input, select, textarea {
      border: 2px solid var(--color-black);
    }
    
    .checkbox-indicator, .radio-indicator {
      border: 2px solid var(--color-black);
    }
    
    /* Contrast testing sections */
    .contrast-test-light {
      /* Force light mode colors */
      --color-background: #FFFFFF;
      --color-surface: #F5F5F5;
      --color-surface-variant: #EEEEEE;
      --color-border: #DDDDDD;
      --color-text-primary: #121212;
      --color-text-secondary: #555555;
      --color-text-hint: #888888;
      background-color: var(--color-background);
      color: var(--color-text-primary);
      border: 2px solid #000;
      margin: 1rem 0;
      padding: 1rem;
    }
    
    .contrast-test-dark {
      /* Force dark mode colors */
      --color-background: #121212;
      --color-surface: #1E1E1E;
      --color-surface-variant: #2A2A2A;
      --color-border: #333333;
      --color-text-primary: #FFFFFF;
      --color-text-secondary: #CCCCCC;
      --color-text-hint: #999999;
      background-color: var(--color-background);
      color: var(--color-text-primary);
      border: 2px solid #FFF;
      margin: 1rem 0;
      padding: 1rem;
    }
    
    /* Contrast ratio display */
    .contrast-info {
      font-family: monospace;
      font-size: 0.875rem;
      padding: 0.5rem;
      background: rgba(0,0,0,0.1);
      margin: 0.5rem 0;
    }
    
    .contrast-pass { color: #2A8A31; font-weight: bold; }
    .contrast-fail { color: #F4464F; font-weight: bold; }
    
    /* Override dark mode for main demo content */
    @media (prefers-color-scheme: dark) {
      body:not(.allow-dark-mode) {
        --color-background: #FFFFFF;
        --color-surface: #F5F5F5;
        --color-surface-variant: #EEEEEE;
        --color-border: #DDDDDD;
        --color-text-primary: #121212;
        --color-text-secondary: #555555;
        --color-text-hint: #888888;
        background-color: var(--color-background);
        color: var(--color-text-primary);
      }
    }
  </style>
</head>
<body>
  <main class="container mx-auto py-8">
    <Stack space="xl">
      <Box padding="lg" border="normal" background="surface">
        <Heading level={1}>Design System Components</Heading>
        <Text variant="body">
          This page demonstrates the components implemented for the design system.
          All components are responsive, accessible, and support bilingual content.
        </Text>
      </Box>

      <!-- Typography Components Demo -->
      <section>
        <Box padding="md" border="thin" background="surface-variant">
          <Heading level={2}>Typography Components</Heading>
          <Text variant="body-sm">Heading, Text, and Link components with various configurations</Text>
        </Box>
        
        <Stack space="md" class="mt-4">
          <Box padding="md" border="normal" background="surface">
            <Heading level={2}>Heading Component</Heading>
            <Stack space="md">
              <Heading level={1}>Heading Level 1</Heading>
              <Heading level={2}>Heading Level 2</Heading>
              <Heading level={3}>Heading Level 3</Heading>
              <Heading level={4}>Heading Level 4</Heading>
              <Heading level={5}>Heading Level 5</Heading>
              <Heading level={6}>Heading Level 6</Heading>
            </Stack>
          </Box>
          
          <Box padding="md" border="normal" background="surface">
            <Heading level={2}>Text Component</Heading>
            <Stack space="md">
              <Text variant="body-lg">Body Large: This is larger body text for important paragraphs.</Text>
              <Text variant="body">Body: This is standard body text for most content.</Text>
              <Text variant="body-sm">Body Small: This is smaller body text for less important content.</Text>
              <Text variant="caption">Caption: This is caption text for images and supplementary content.</Text>
              <Text variant="overline">OVERLINE: THIS IS OVERLINE TEXT FOR LABELS AND CATEGORIES</Text>
            </Stack>
          </Box>
          
          <Box padding="md" border="normal" background="surface">
            <Heading level={2}>Link Component</Heading>
            <Stack space="md">
              <Link href="#" variant="default">Default Link Style</Link>
              <Link href="#" variant="button">Button-Style Link</Link>
              <Link href="#" variant="nav">Navigation Link Style</Link>
              <Link href="#" variant="inline">Inline Link Style</Link>
              <Link href="https://example.com" variant="default">External Link (opens in new tab)</Link>
              <Link href="#" variant="default" disabled>Disabled Link</Link>
            </Stack>
          </Box>
        </Stack>
      </section>

      <!-- Stack Component Demo -->
      <section>
        <Box padding="md" border="thin" background="surface-variant">
          <Heading level={2}>Stack Component</Heading>
          <Text variant="body-sm">Vertical layout with consistent spacing</Text>
        </Box>
        
        <Stack space="md" class="mt-4">
          <Box padding="sm" border="normal" background="primary">
            <p class="text-style-body text-white">Stack Item 1</p>
          </Box>
          <Box padding="sm" border="normal" background="secondary">
            <p class="text-style-body text-white">Stack Item 2</p>
          </Box>
          <Box padding="sm" border="normal" background="surface">
            <p class="text-style-body">Stack Item 3</p>
          </Box>
        </Stack>
      </section>

      <!-- Cluster Component Demo -->
      <section>
        <Box padding="md" border="thin" background="surface-variant">
          <Heading level={2}>Cluster Component</Heading>
          <Text variant="body-sm">Horizontal layout with wrapping</Text>
        </Box>
        
        <Cluster space="sm" justify="start" class="mt-4">
          <Box padding="xs" border="normal" background="primary">
            <span class="text-style-body-sm text-white">Tag 1</span>
          </Box>
          <Box padding="xs" border="normal" background="secondary">
            <span class="text-style-body-sm text-white">Tag 2</span>
          </Box>
          <Box padding="xs" border="normal" background="surface">
            <span class="text-style-body-sm">Tag 3</span>
          </Box>
          <Box padding="xs" border="normal" background="primary">
            <span class="text-style-body-sm text-white">Tag 4</span>
          </Box>
          <Box padding="xs" border="normal" background="secondary">
            <span class="text-style-body-sm text-white">Tag 5</span>
          </Box>
        </Cluster>
      </section>

      <!-- Grid Component Demo -->
      <section>
        <Box padding="md" border="thin" background="surface-variant">
          <Heading level={2}>Grid Component</Heading>
          <Text variant="body-sm">Two-dimensional layout with auto-fit columns</Text>
        </Box>
        
        <Grid minItemWidth="200px" gap="md" class="mt-4">
          <Box padding="md" border="normal" background="primary">
            <h3 class="text-style-heading-6 text-white">Card 1</h3>
            <p class="text-style-body-sm text-white">This is a sample card in the grid layout.</p>
          </Box>
          <Box padding="md" border="normal" background="secondary">
            <h3 class="text-style-heading-6 text-white">Card 2</h3>
            <p class="text-style-body-sm text-white">Another card that demonstrates responsive behavior.</p>
          </Box>
          <Box padding="md" border="normal" background="surface">
            <h3 class="text-style-heading-6">Card 3</h3>
            <p class="text-style-body-sm">A third card showing the auto-fit behavior.</p>
          </Box>
          <Box padding="md" border="normal" background="primary">
            <h3 class="text-style-heading-6 text-white">Card 4</h3>
            <p class="text-style-body-sm text-white">Fourth card in the responsive grid.</p>
          </Box>
        </Grid>
      </section>

      <!-- Box Component Demo -->
      <section>
        <Box padding="md" border="thin" background="surface-variant">
          <Heading level={2}>Box Component</Heading>
          <Text variant="body-sm">Container with configurable padding and borders</Text>
        </Box>
        
        <Stack space="sm" class="mt-4">
          <Box padding="sm" border="thin" background="surface">
            <p class="text-style-body">Small padding, thin border</p>
          </Box>
          <Box padding="md" border="normal" background="surface">
            <p class="text-style-body">Medium padding, normal border</p>
          </Box>
          <Box padding="lg" border="thick" background="surface">
            <p class="text-style-body">Large padding, thick border</p>
          </Box>
          <Box padding="md" border="brutalist" background="primary" shadow="md">
            <p class="text-style-body text-white">Neo-brutalist styling with shadow</p>
          </Box>
        </Stack>
      </section>

      <!-- Sidebar Component Demo -->
      <section>
        <Box padding="md" border="thin" background="surface-variant">
          <Heading level={2}>Sidebar Component</Heading>
          <Text variant="body-sm">Flexible sidebar layout with responsive behavior</Text>
        </Box>
        
        <Sidebar sidebarWidth="200px" contentMin="60%" gap="md" class="mt-4 min-h-64">
          <Box padding="md" border="normal" background="surface" slot="sidebar">
            <h4 class="text-style-heading-6">Sidebar</h4>
            <Stack space="xs">
              <a href="#" class="text-style-link">Navigation Item 1</a>
              <a href="#" class="text-style-link">Navigation Item 2</a>
              <a href="#" class="text-style-link">Navigation Item 3</a>
            </Stack>
          </Box>
          
          <Box padding="md" border="normal" background="surface">
            <h4 class="text-style-heading-6">Main Content</h4>
            <p class="text-style-body">
              This is the main content area. The sidebar will stack vertically on smaller screens
              and maintain a horizontal layout on larger screens. The layout is intrinsically responsive
              and adapts to content length.
            </p>
            <p class="text-style-body">
              The sidebar component supports both left and right positioning, collapsible behavior,
              and various width configurations to accommodate different use cases.
            </p>
          </Box>
        </Sidebar>
      </section>

      <!-- Bilingual Support Demo -->
      <section>
        <Box padding="md" border="thin" background="surface-variant">
          <Heading level={2}>Bilingual Support</Heading>
          <Text variant="body-sm">Components adapt to longer French text</Text>
        </Box>
        
        <Stack space="md" class="mt-4">
          <Cluster space="sm" justify="start">
            <Box padding="xs" border="normal" background="primary">
              <span class="text-style-body-sm text-white">English</span>
            </Box>
            <Box padding="xs" border="normal" background="secondary">
              <span class="text-style-body-sm text-white">Français (plus long)</span>
            </Box>
            <Box padding="xs" border="normal" background="surface">
              <span class="text-style-body-sm">Multilingual Support</span>
            </Box>
          </Cluster>
          
          <Grid minItemWidth="250px" gap="md">
            <Box padding="md" border="normal" background="surface">
              <h4 class="text-style-heading-6">English Content</h4>
              <p class="text-style-body-sm">Short and concise text content.</p>
            </Box>
            <Box padding="md" border="normal" background="surface">
              <h4 class="text-style-heading-6">Contenu Français</h4>
              <p class="text-style-body-sm">Texte plus long qui démontre l'adaptation aux langues avec plus de caractères.</p>
            </Box>
          </Grid>
        </Stack>
      </section>

      <!-- Contrast Testing Demo -->
      <section>
        <Box padding="md" border="thin" background="surface-variant">
          <Heading level={2}>Contrast Testing</Heading>
          <Text variant="body-sm">Testing color combinations in both light and dark modes</Text>
        </Box>
        
        <Stack space="lg" class="mt-4">
          <!-- Light Mode Testing -->
          <div class="contrast-test-light">
            <h3 class="text-style-heading-4">Light Mode Contrast Testing</h3>
            <div class="contrast-info">
              Background: #FFFFFF | Text: #121212 | Ratio: 17.77:1 <span class="contrast-pass">✓ AAA</span>
            </div>
            
            <Grid minItemWidth="200px" gap="md" class="mt-4">
              <Box padding="md" border="normal" style="background-color: #1F7A22;">
                <h4 style="color: #FFFFFF; margin: 0;">Green Primary</h4>
                <p style="color: #FFFFFF; margin: 0.5rem 0 0 0; font-size: 0.875rem;">
                  #1F7A22 on #FFFFFF: 5.01:1 <span class="contrast-pass">✓ AA</span>
                </p>
              </Box>
              
              <Box padding="md" border="normal" style="background-color: #3A5AD7;">
                <h4 style="color: #FFFFFF; margin: 0;">Blue Primary</h4>
                <p style="color: #FFFFFF; margin: 0.5rem 0 0 0; font-size: 0.875rem;">
                  #3A5AD7 on #FFFFFF: 5.89:1 <span class="contrast-pass">✓ AA</span>
                </p>
              </Box>
              
              <Box padding="md" border="normal" style="background-color: #F5F5F5;">
                <h4 style="color: #121212; margin: 0;">Surface</h4>
                <p style="color: #121212; margin: 0.5rem 0 0 0; font-size: 0.875rem;">
                  #121212 on #F5F5F5: 16.54:1 <span class="contrast-pass">✓ AAA</span>
                </p>
              </Box>
              
              <Box padding="md" border="normal" style="background-color: #EEEEEE;">
                <h4 style="color: #121212; margin: 0;">Surface Variant</h4>
                <p style="color: #121212; margin: 0.5rem 0 0 0; font-size: 0.875rem;">
                  #121212 on #EEEEEE: 15.21:1 <span class="contrast-pass">✓ AAA</span>
                </p>
              </Box>
            </Grid>
          </div>
          
          <!-- Dark Mode Testing -->
          <div class="contrast-test-dark">
            <h3 class="text-style-heading-4" style="color: #FFFFFF;">Dark Mode Contrast Testing</h3>
            <div class="contrast-info" style="background: rgba(255,255,255,0.1); color: #FFFFFF;">
              Background: #121212 | Text: #FFFFFF | Ratio: 17.77:1 <span class="contrast-pass">✓ AAA</span>
            </div>
            
            <Grid minItemWidth="200px" gap="md" class="mt-4">
              <Box padding="md" border="normal" style="background-color: #1F7A22;">
                <h4 style="color: #FFFFFF; margin: 0;">Green Primary</h4>
                <p style="color: #FFFFFF; margin: 0.5rem 0 0 0; font-size: 0.875rem;">
                  #FFFFFF on #1F7A22: 5.01:1 <span class="contrast-pass">✓ AA</span>
                </p>
              </Box>
              
              <Box padding="md" border="normal" style="background-color: #3A5AD7;">
                <h4 style="color: #FFFFFF; margin: 0;">Blue Primary</h4>
                <p style="color: #FFFFFF; margin: 0.5rem 0 0 0; font-size: 0.875rem;">
                  #FFFFFF on #3A5AD7: 5.89:1 <span class="contrast-pass">✓ AA</span>
                </p>
              </Box>
              
              <Box padding="md" border="normal" style="background-color: #1E1E1E;">
                <h4 style="color: #FFFFFF; margin: 0;">Dark Surface</h4>
                <p style="color: #FFFFFF; margin: 0.5rem 0 0 0; font-size: 0.875rem;">
                  #FFFFFF on #1E1E1E: 14.85:1 <span class="contrast-pass">✓ AAA</span>
                </p>
              </Box>
              
              <Box padding="md" border="normal" style="background-color: #2A2A2A;">
                <h4 style="color: #FFFFFF; margin: 0;">Dark Surface Variant</h4>
                <p style="color: #FFFFFF; margin: 0.5rem 0 0 0; font-size: 0.875rem;">
                  #FFFFFF on #2A2A2A: 12.63:1 <span class="contrast-pass">✓ AAA</span>
                </p>
              </Box>
            </Grid>
          </div>
          
          <!-- Contrast Standards Info -->
          <Box padding="md" border="normal" background="surface">
            <h4 class="text-style-heading-6">WCAG 2.1 Contrast Standards</h4>
            <Stack space="xs">
              <p class="text-style-body-sm">
                <strong>AA Level (Minimum):</strong> 4.5:1 for normal text, 3:1 for large text
              </p>
              <p class="text-style-body-sm">
                <strong>AAA Level (Enhanced):</strong> 7:1 for normal text, 4.5:1 for large text
              </p>
              <p class="text-style-body-sm">
                All color combinations in our design system meet or exceed AA standards, with most achieving AAA level contrast.
              </p>
            </Stack>
          </Box>
        </Stack>
      </section>

      <!-- Button Component Demo -->
      <section>
        <Box padding="md" border="thin" background="surface-variant">
          <Heading level={2}>Button Component</Heading>
          <Text variant="body-sm">Interactive button with different variants, sizes, and states</Text>
        </Box>
        
        <Stack space="md" class="mt-4">
          <Box padding="md" border="normal" background="surface">
            <Heading level={3}>Button Variants</Heading>
            <Cluster space="md" justify="start" class="mt-4">
              <Button variant="primary">Primary Button</Button>
              <Button variant="secondary">Secondary Button</Button>
              <Button variant="tertiary">Tertiary Button</Button>
              <Button variant="ghost">Ghost Button</Button>
            </Cluster>
            
            <div class="debug-info">
              <p>CSS Variables:</p>
              <ul>
                <li>--color-green: <span id="color-green"></span></li>
                <li>--color-blue: <span id="color-blue"></span></li>
                <li>--color-yellow: <span id="color-yellow"></span></li>
                <li>--color-black: <span id="color-black"></span></li>
                <li>--color-white: <span id="color-white"></span></li>
              </ul>
              
              <p>Raw HTML Buttons with CSS Variables:</p>
              <div style="display: flex; gap: 1rem; margin-top: 0.5rem;">
                <button style="background-color: var(--color-green); color: white; padding: 0.5rem 1rem; border: 2px solid black; font-weight: bold;">Primary Button</button>
                <button style="background-color: var(--color-blue); color: white; padding: 0.5rem 1rem; border: 2px solid black; font-weight: bold;">Secondary Button</button>
                <button style="background-color: var(--color-yellow); color: black; padding: 0.5rem 1rem; border: 2px solid black; font-weight: bold;">Tertiary Button</button>
                <button style="background-color: transparent; color: black; padding: 0.5rem 1rem; border: 2px solid black; font-weight: bold;">Ghost Button</button>
              </div>
              
              <p>Tailwind Classes:</p>
              <div style="display: flex; gap: 1rem; margin-top: 0.5rem;">
                <button class="bg-green text-white px-4 py-2 border-2 border-black font-bold">Primary Button</button>
                <button class="bg-blue text-white px-4 py-2 border-2 border-black font-bold">Secondary Button</button>
                <button class="bg-yellow text-black px-4 py-2 border-2 border-black font-bold">Tertiary Button</button>
                <button class="bg-transparent text-black px-4 py-2 border-2 border-black font-bold">Ghost Button</button>
              </div>
            </div>
            
            <script>
              // Display CSS variable values
              const root = document.documentElement;
              const cssVars = [
                'green',
                'blue',
                'yellow',
                'black',
                'white'
              ];
              
              cssVars.forEach(varName => {
                const value = getComputedStyle(root).getPropertyValue(`--color-${varName}`);
                const el = document.getElementById(`color-${varName}`);
                if (el) {
                  el.textContent = value;
                  el.style.backgroundColor = value;
                  el.style.color = varName === 'black' || varName === 'blue' || varName === 'green' ? 'white' : 'black';
                  el.style.padding = '0 0.5rem';
                }
              });
            </script>
          </Box>
          
          <Box padding="md" border="normal" background="surface">
            <Heading level={3}>Button Sizes</Heading>
            <Cluster space="md" justify="start" class="mt-4">
              <Button variant="primary" size="sm">Small Button</Button>
              <Button variant="primary" size="md">Medium Button</Button>
              <Button variant="primary" size="lg">Large Button</Button>
            </Cluster>
          </Box>
          
          <Box padding="md" border="normal" background="surface">
            <Heading level={3}>Button States</Heading>
            <Cluster space="md" justify="start" class="mt-4">
              <Button variant="primary">Normal Button</Button>
              <Button variant="primary" disabled>Disabled Button</Button>
              <Button variant="primary" loading>Loading Button</Button>
              <Button variant="primary" fullWidth>Full Width Button</Button>
            </Cluster>
          </Box>
          
          <Box padding="md" border="normal" background="surface">
            <Heading level={3}>Button Interactive States</Heading>
            <Text variant="body-sm" class="mb-4">Interact with these buttons to see their hover and active states</Text>
            
            <div class="grid grid-cols-2 gap-8 mb-8">
              <div>
                <Heading level={4} class="mb-2">Primary Button</Heading>
                <div class="flex flex-col gap-4">
                  <div class="flex items-center gap-8">
                    <div>
                      <Text variant="body-sm" class="mb-1">Normal</Text>
                      <Button variant="primary">Primary</Button>
                    </div>
                    <div>
                      <Text variant="body-sm" class="mb-1">Hover</Text>
                      <div class="bg-green-dark text-white px-4 py-2 border-brutalist neo-shadow font-bold">Primary</div>
                    </div>
                    <div>
                      <Text variant="body-sm" class="mb-1">Active</Text>
                      <div class="bg-green-dark text-white px-4 py-2 border-brutalist font-bold">Primary</div>
                    </div>
                  </div>
                  <Text variant="caption">Try it: <Button variant="primary">Click Me</Button></Text>
                </div>
              </div>
              
              <div>
                <Heading level={4} class="mb-2">Secondary Button</Heading>
                <div class="flex flex-col gap-4">
                  <div class="flex items-center gap-8">
                    <div>
                      <Text variant="body-sm" class="mb-1">Normal</Text>
                      <Button variant="secondary">Secondary</Button>
                    </div>
                    <div>
                      <Text variant="body-sm" class="mb-1">Hover</Text>
                      <div class="bg-blue-dark text-white px-4 py-2 border-brutalist neo-shadow font-bold">Secondary</div>
                    </div>
                    <div>
                      <Text variant="body-sm" class="mb-1">Active</Text>
                      <div class="bg-blue-dark text-white px-4 py-2 border-brutalist font-bold">Secondary</div>
                    </div>
                  </div>
                  <Text variant="caption">Try it: <Button variant="secondary">Click Me</Button></Text>
                </div>
              </div>
              
              <div>
                <Heading level={4} class="mb-2">Tertiary Button</Heading>
                <div class="flex flex-col gap-4">
                  <div class="flex items-center gap-8">
                    <div>
                      <Text variant="body-sm" class="mb-1">Normal</Text>
                      <Button variant="tertiary">Tertiary</Button>
                    </div>
                    <div>
                      <Text variant="body-sm" class="mb-1">Hover</Text>
                      <div class="bg-yellow-dark text-black px-4 py-2 border-brutalist neo-shadow font-bold">Tertiary</div>
                    </div>
                    <div>
                      <Text variant="body-sm" class="mb-1">Active</Text>
                      <div class="bg-yellow-dark text-black px-4 py-2 border-brutalist font-bold">Tertiary</div>
                    </div>
                  </div>
                  <Text variant="caption">Try it: <Button variant="tertiary">Click Me</Button></Text>
                </div>
              </div>
              
              <div>
                <Heading level={4} class="mb-2">Ghost Button</Heading>
                <div class="flex flex-col gap-4">
                  <div class="flex items-center gap-8">
                    <div>
                      <Text variant="body-sm" class="mb-1">Normal</Text>
                      <Button variant="ghost">Ghost</Button>
                    </div>
                    <div>
                      <Text variant="body-sm" class="mb-1">Hover</Text>
                      <div class="bg-surface text-black px-4 py-2 border-normal font-bold">Ghost</div>
                    </div>
                    <div>
                      <Text variant="body-sm" class="mb-1">Active</Text>
                      <div class="bg-surface text-black px-4 py-2 border-normal font-bold">Ghost</div>
                    </div>
                  </div>
                  <Text variant="caption">Try it: <Button variant="ghost">Click Me</Button></Text>
                </div>
              </div>
            </div>
            
            <Box padding="md" border="thin" background="surface-variant">
              <Heading level={4}>Neo-Brutalist Button Interaction</Heading>
              <Text variant="body-sm">
                The buttons follow neo-brutalist design principles:
                <ul class="list-disc ml-6 mt-2">
                  <li>Bold borders and strong shadows create a 3D effect</li>
                  <li>On hover, the shadow increases slightly</li>
                  <li>When clicked, the button moves diagonally toward the shadow</li>
                  <li>The shadow stays in place during the click, creating a "pressing" effect</li>
                </ul>
              </Text>
            </Box>
          </Box>
          
          <Box padding="md" border="normal" background="surface">
            <Heading level={3}>Button as Link</Heading>
            <Cluster space="md" justify="start" class="mt-4">
              <Button variant="primary" href="#">Link Button</Button>
              <Button variant="secondary" href="https://example.com">External Link Button</Button>
              <Button variant="ghost" href="#" disabled>Disabled Link Button</Button>
            </Cluster>
          </Box>
        </Stack>
      </section>
      
      <!-- Input Component Demo -->
      <section>
        <Box padding="md" border="thin" background="surface-variant">
          <Heading level={2}>Input Component</Heading>
          <Text variant="body-sm">Form input with label and error states</Text>
        </Box>
        
        <Stack space="md" class="mt-4">
          <Box padding="md" border="normal" background="surface">
            <Heading level={3}>Input Types</Heading>
            <Grid minItemWidth="250px" gap="md" class="mt-4">
              <Input 
                type="text" 
                label="Text Input" 
                name="text-input" 
                placeholder="Enter text"
              />
              <Input 
                type="email" 
                label="Email Input" 
                name="email-input" 
                placeholder="Enter email"
              />
              <Input 
                type="password" 
                label="Password Input" 
                name="password-input" 
                placeholder="Enter password"
              />
              <Input 
                type="number" 
                label="Number Input" 
                name="number-input" 
                placeholder="Enter number"
              />
            </Grid>
          </Box>
          
          <Box padding="md" border="normal" background="surface">
            <Heading level={3}>Input States</Heading>
            <Grid minItemWidth="250px" gap="md" class="mt-4">
              <Input 
                label="Required Input" 
                name="required-input" 
                placeholder="This field is required"
                required
              />
              <Input 
                label="Disabled Input" 
                name="disabled-input" 
                placeholder="This field is disabled"
                value="Disabled value"
                disabled
              />
              <Input 
                label="Input with Error" 
                name="error-input" 
                placeholder="This field has an error"
                value="Invalid value"
                error="This field contains an error"
              />
              <Input 
                label="Input with Value" 
                name="value-input" 
                placeholder="This field has a value"
                value="Prefilled value"
              />
            </Grid>
          </Box>
          
          <Box padding="md" border="normal" background="surface">
            <Heading level={3}>Bilingual Support</Heading>
            <Grid minItemWidth="250px" gap="md" class="mt-4">
              <Input 
                label="First Name" 
                name="first-name" 
                placeholder="Enter your first name"
              />
              <Input 
                label="Prénom (French is typically longer)" 
                name="prenom" 
                placeholder="Entrez votre prénom"
              />
            </Grid>
          </Box>
        </Stack>
      </section>
      
      <!-- Select Component Demo -->
      <section>
        <Box padding="md" border="thin" background="surface-variant">
          <Heading level={2}>Select Component</Heading>
          <Text variant="body-sm">Form select with label, option groups, and error states</Text>
        </Box>
        
        <Stack space="md" class="mt-4">
          <Box padding="md" border="normal" background="surface">
            <Heading level={3}>Basic Select</Heading>
            <Grid minItemWidth="250px" gap="md" class="mt-4">
              <Select 
                label="Country" 
                name="country" 
                placeholder="Select a country"
                options={[
                  { value: 'ca', label: 'Canada' },
                  { value: 'us', label: 'United States' },
                  { value: 'mx', label: 'Mexico' },
                  { value: 'fr', label: 'France' }
                ]}
              />
              
              <Select 
                label="Language" 
                name="language" 
                placeholder="Select a language"
                value="fr"
                options={[
                  { value: 'en', label: 'English' },
                  { value: 'fr', label: 'French' },
                  { value: 'es', label: 'Spanish' }
                ]}
              />
            </Grid>
          </Box>
          
          <Box padding="md" border="normal" background="surface">
            <Heading level={3}>Select with Option Groups</Heading>
            <Select 
              label="Region" 
              name="region" 
              placeholder="Select a region"
              options={[
                { 
                  label: 'North America', 
                  options: [
                    { value: 'ca', label: 'Canada' },
                    { value: 'us', label: 'United States' },
                    { value: 'mx', label: 'Mexico' }
                  ]
                },
                { 
                  label: 'Europe', 
                  options: [
                    { value: 'fr', label: 'France' },
                    { value: 'de', label: 'Germany' },
                    { value: 'uk', label: 'United Kingdom' }
                  ]
                }
              ]}
            />
          </Box>
          
          <Box padding="md" border="normal" background="surface">
            <Heading level={3}>Select States</Heading>
            <Grid minItemWidth="250px" gap="md" class="mt-4">
              <Select 
                label="Required Select" 
                name="required-select" 
                placeholder="This field is required"
                required
                options={[
                  { value: 'option1', label: 'Option 1' },
                  { value: 'option2', label: 'Option 2' }
                ]}
              />
              
              <Select 
                label="Disabled Select" 
                name="disabled-select" 
                placeholder="This field is disabled"
                disabled
                options={[
                  { value: 'option1', label: 'Option 1' },
                  { value: 'option2', label: 'Option 2' }
                ]}
              />
              
              <Select 
                label="Select with Error" 
                name="error-select" 
                placeholder="This field has an error"
                error="Please select a valid option"
                options={[
                  { value: 'option1', label: 'Option 1' },
                  { value: 'option2', label: 'Option 2' }
                ]}
              />
              
              <Select 
                label="Select with Disabled Options" 
                name="disabled-options-select" 
                placeholder="Some options are disabled"
                options={[
                  { value: 'option1', label: 'Option 1' },
                  { value: 'option2', label: 'Option 2', disabled: true },
                  { value: 'option3', label: 'Option 3' }
                ]}
              />
            </Grid>
          </Box>
          
          <Box padding="md" border="normal" background="surface">
            <Heading level={3}>Bilingual Support</Heading>
            <Grid minItemWidth="250px" gap="md" class="mt-4">
              <Select 
                label="Preferred Language" 
                name="preferred-language" 
                placeholder="Select your preferred language"
                options={[
                  { value: 'en', label: 'English' },
                  { value: 'fr', label: 'French' }
                ]}
              />
              
              <Select 
                label="Langue préférée (French is typically longer)" 
                name="langue-preferee" 
                placeholder="Sélectionnez votre langue préférée"
                options={[
                  { value: 'en', label: 'Anglais' },
                  { value: 'fr', label: 'Français' }
                ]}
              />
            </Grid>
          </Box>
        </Stack>
      </section>
      
      <!-- Checkbox and Radio Components Demo -->
      <section>
        <Box padding="md" border="thin" background="surface-variant">
          <Heading level={2}>Checkbox and Radio Components</Heading>
          <Text variant="body-sm">Form checkbox and radio button components with custom styling</Text>
        </Box>
        
        <Stack space="md" class="mt-4">
          <Box padding="md" border="normal" background="surface">
            <Heading level={3}>Checkbox Component</Heading>
            <Stack space="sm" class="mt-4">
              <Checkbox 
                label="Default Checkbox" 
                name="default-checkbox"
              />
              
              <Checkbox 
                label="Checked Checkbox" 
                name="checked-checkbox"
                checked
              />
              
              <Checkbox 
                label="Required Checkbox" 
                name="required-checkbox"
                required
              />
              
              <Checkbox 
                label="Disabled Checkbox" 
                name="disabled-checkbox"
                disabled
              />
              
              <Checkbox 
                label="Disabled Checked Checkbox" 
                name="disabled-checked-checkbox"
                checked
                disabled
              />
              
              <Checkbox 
                label="Checkbox with Error" 
                name="error-checkbox"
                error="This field has an error"
              />
            </Stack>
          </Box>
          
          <Box padding="md" border="normal" background="surface">
            <Heading level={3}>Radio Component</Heading>
            <Stack space="sm" class="mt-4">
              <div>
                <Heading level={4} class="mb-2">Gender</Heading>
                <Radio 
                  label="Male" 
                  name="gender"
                  value="male"
                />
                
                <Radio 
                  label="Female" 
                  name="gender"
                  value="female"
                  checked
                />
                
                <Radio 
                  label="Non-binary" 
                  name="gender"
                  value="non-binary"
                />
              </div>
              
              <div class="mt-4">
                <Heading level={4} class="mb-2">Radio States</Heading>
                <Radio 
                  label="Required Radio" 
                  name="radio-states"
                  value="required"
                  required
                />
                
                <Radio 
                  label="Disabled Radio" 
                  name="radio-states"
                  value="disabled"
                  disabled
                />
                
                <Radio 
                  label="Disabled Checked Radio" 
                  name="radio-states"
                  value="disabled-checked"
                  checked
                  disabled
                />
                
                <Radio 
                  label="Radio with Error" 
                  name="radio-states"
                  value="error"
                  error="This field has an error"
                />
              </div>
            </Stack>
          </Box>
          
          <Box padding="md" border="normal" background="surface">
            <Heading level={3}>Bilingual Support</Heading>
            <Grid minItemWidth="250px" gap="md" class="mt-4">
              <div>
                <Heading level={4} class="mb-2">English</Heading>
                <Checkbox 
                  label="I agree to the terms and conditions" 
                  name="terms-en"
                  required
                />
              </div>
              
              <div>
                <Heading level={4} class="mb-2">French</Heading>
                <Checkbox 
                  label="J'accepte les termes et conditions (French is typically longer)" 
                  name="terms-fr"
                  required
                />
              </div>
            </Grid>
          </Box>
        </Stack>
      </section>
      
      <!-- Accessibility Features Demo -->
      <section>
        <Box padding="md" border="thin" background="surface-variant">
          <Heading level={2}>Accessibility Features</Heading>
          <Text variant="body-sm">Components include focus management and touch-friendly sizing</Text>
        </Box>
        
        <Stack space="md" class="mt-4">
          <Cluster space="md" justify="start">
            <Button variant="primary">Accessible Button 1</Button>
            <Button variant="secondary">Accessible Button 2</Button>
            <Button variant="ghost">Accessible Button 3</Button>
          </Cluster>
          
          <Box padding="md" border="normal" background="surface">
            <p class="text-style-body">
              All components include proper focus management, adequate spacing for touch targets,
              and support for reduced motion preferences. They work well with screen readers
              and maintain proper contrast ratios.
            </p>
          </Box>
        </Stack>
      </section>
    </Stack>
  </main>
</body>
</html>